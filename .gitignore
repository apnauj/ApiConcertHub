###########################################
# 1. Artefactos de Compilación (.NET)
###########################################
[Bb]in/
[Oo]bj/
# Archivos de publicación
publish/
# Símbolos de depuración
*.pdb
*.suo
*.user
*.userosscache
*.sln.docstates

###########################################
# 2. Configuración de Herramientas e IDEs
###########################################
# JetBrains (Rider)
.idea/
*.sln.iml

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio (Windows/Mac)
.vs/

###########################################
# 3. Gestión de Dependencias
###########################################
# Caché de paquetes NuGet
project.assets.json
project.nuget.cache
*.nuget.props
*.nuget.targets

###########################################
# 4. Configuración del Entorno y Secretos
###########################################
# Archivo de configuración local con secretos
# Se recomienda mantener appsettings.json para la estructura básica
# pero ignorar el que contiene credenciales de desarrollo reales.
appsettings.Development.json

# Almacén de secretos de .NET
# (Si usas User Secrets, suelen estar fuera del directorio del proyecto, 
# pero es buena práctica cubrirlo si se guardan localmente)
Secrets/
secrets.json

###########################################
# 5. Bases de Datos y Logs
###########################################
*.log
*.sqlite
*.db
# SQL Server local data
App_Data/

###########################################
# 6. Sistema Operativo (Linux/Unix)
###########################################
.DS_Store
.nfs*
*~
*.swp
